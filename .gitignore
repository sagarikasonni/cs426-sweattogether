# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node modules (both frontend and backend)
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
dist-ssr/
frontend/dist/
backend/dist/

# Local environment files
*.local
.env
frontend/.env
backend/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker
docker-compose.override.yml
*.pid

# Python virtual environments (never commit these)
matching_env/
front-end/matching_env/
backend/matching_env/
venv/
.venv/
env/

# Python caches & build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Coverage data (the .coveragerc config IS tracked; this generated data is not)
.coverage
.coverage.*
htmlcov/

# Large binary libs that should never be in git
*.dylib
*.so